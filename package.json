{
  "name": "dsh-agent-frugality",
  "version": "0.1.3",
  "description": "DSH 对抗多智能体三层失效的防御插件：读取台账去重度量(read-ledger)、免疫压缩规则区+完成机械门禁(immutable-core+completion-gate)、低成本审查lane(role-router)。零外部依赖，注入即用。",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.6"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "test": "node --test test/core.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongyijie85/dsh-agent-frugality.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "multi-agent",
    "ai-agents",
    "agent-cost",
    "cost-optimization",
    "token-efficiency",
    "context-management",
    "subagent",
    "completion-gate",
    "tool-ledger"
  ],
  "files": [
    "lib",
    "docs",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "dsh.plugin.json",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.0.1-rc.1": "incompatible",
        "0.0.1-rc.2": "incompatible",
        "0.0.1-rc.5": "incompatible",
        "0.1.0-rc.2": "incompatible",
        "0.1.0-rc.3": "incompatible",
        "0.1.0-rc.6": "compatible",
        "0.1.0-rc.7": "compatible",
        "0.1.0-rc.8": "compatible",
        "0.1.1-rc.1": "compatible",
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.2": "compatible",
        "0.1.2-alpha.3": "compatible",
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.2": "compatible",
        "0.1.5-alpha.1": "compatible",
        "0.1.5-alpha.2": "compatible",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible"
      }
    }
  }
}
